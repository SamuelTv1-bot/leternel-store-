{
  "name": "leternel-store-functions",
  "version": "1.0.0",
  "description": "Secure Cloud Functions backend for L'ÉTERNEL Store.",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "serve": "firebase emulators:start --only functions,firestore,auth,storage",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "node --test",
    "test:rules": "node --test test/firestore-rules.test.js",
    "test:storage-rules": "node --test test/storage-rules.test.js",
    "test:emulator:checkout": "node --test test/emulator/full-stack-checkout.emulator.test.js"
    },
  "dependencies": {
    "firebase-admin": "^14.1.0",
    "firebase-functions": "^7.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "eslint": "^9.0.0",
    "firebase": "^11.0.0",
    "firebase-functions-test": "^3.5.0",
    "globals": "^16.0.0"
  }  
}