# ==========================================================
# L'ÉTERNEL STORE
# CLOUD FUNCTIONS ENVIRONMENT VARIABLES
#
# Copy this file to:
# functions/.env
#
# Never commit real secrets.
# ==========================================================


# ==========================================================
# APPLICATION
# ==========================================================

NODE_ENV=development

FIREBASE_PROJECT_ID=leternel-store
FUNCTIONS_REGION=europe-west1

APP_ORIGIN=http://localhost:5000
STORE_NAME=L'ÉTERNEL

DEFAULT_CURRENCY=NGN
DEFAULT_LOCALE=en-NG

SUPPORT_EMAIL=support@example.com
ORDER_EMAIL=orders@example.com


# ==========================================================
# CORS
#
# Comma-separated list of permitted frontend origins.
# ==========================================================

ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5173,http://127.0.0.1:5000


# ==========================================================
# DELIVERY
#
# Monetary amounts use the store's major currency unit.
# Example: 10000 means ₦10,000.
# ==========================================================

FREE_STANDARD_DELIVERY_THRESHOLD=500000
STANDARD_DELIVERY_FEE=10000
EXPRESS_DELIVERY_FEE=25000

TAX_RATE=0


# ==========================================================
# PAYMENT PROVIDER
#
# Supported values:
# - paystack
# - flutterwave
# ==========================================================

PAYMENT_PROVIDER=paystack


# ==========================================================
# PAYSTACK
# ==========================================================

PAYSTACK_PUBLIC_KEY=pk_test_replace_me
PAYSTACK_SECRET_KEY=sk_test_replace_me

PAYSTACK_CALLBACK_URL=http://localhost:5000/payment/callback
PAYSTACK_WEBHOOK_SECRET=sk_test_replace_me

PAYSTACK_REQUEST_TIMEOUT_MS=15000


# ==========================================================
# FLUTTERWAVE
# ==========================================================

FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-replace-me-X
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-replace-me-X

FLUTTERWAVE_ENCRYPTION_KEY=FLWSECK_TEST-replace-me
FLUTTERWAVE_WEBHOOK_HASH=replace-me

FLUTTERWAVE_CALLBACK_URL=http://localhost:5000/payment/callback

FLUTTERWAVE_REQUEST_TIMEOUT_MS=15000


# ==========================================================
# EMAIL PROVIDER
#
# Supported values:
# - resend
# - sendgrid
# ==========================================================

EMAIL_PROVIDER=resend

EMAIL_FROM=orders@example.com
EMAIL_FROM_NAME=L'ÉTERNEL
EMAIL_REPLY_TO=support@example.com

EMAIL_REQUEST_TIMEOUT_MS=15000


# ==========================================================
# RESEND
# ==========================================================

RESEND_API_KEY=re_replace_me


# ==========================================================
# SENDGRID
# ==========================================================

SENDGRID_API_KEY=SG.replace_me


# ==========================================================
# ORDER CONFIGURATION
# ==========================================================

ORDER_NUMBER_PREFIX=LET

ORDER_IDEMPOTENCY_WINDOW_MINUTES=60
ORDER_PAYMENT_EXPIRY_MINUTES=30

MAX_ORDER_ITEMS=25
MAX_ITEM_QUANTITY=10

ENABLE_ORDER_CONFIRMATION_EMAILS=true
ENABLE_PAYMENT_RECEIPT_EMAILS=true
ENABLE_ORDER_STATUS_EMAILS=true


# ==========================================================
# ACCOUNT CONFIGURATION
# ==========================================================

DEFAULT_USER_ROLE=customer
DEFAULT_USER_STATUS=active

ANONYMIZED_EMAIL_DOMAIN=deleted.leternel.invalid


# ==========================================================
# SECURITY
# ==========================================================

TRUST_PROXY=false

REQUIRE_APP_CHECK=false
REQUIRE_VERIFIED_EMAIL_FOR_CHECKOUT=true

WEBHOOK_MAX_BODY_BYTES=1048576

ADMIN_AUDIT_LOGGING_ENABLED=true


# ==========================================================
# LOGGING
#
# Supported values:
# - debug
# - info
# - warn
# - error
# ==========================================================

LOG_LEVEL=debug

LOG_PROVIDER_RESPONSES=false
LOG_WEBHOOK_PAYLOADS=false


# ==========================================================
# FIREBASE EMULATORS
#
# These are normally injected automatically by
# firebase emulators:exec.
# ==========================================================

FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
FUNCTIONS_EMULATOR_HOST=127.0.0.1:5001


# ==========================================================
# TEST CONFIGURATION
# ==========================================================

EMULATOR_TEST_TIMEOUT=30000

EMULATOR_PAYMENT_PROVIDER_AVAILABLE=false